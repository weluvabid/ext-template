{
  "name": "ext-template",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Manifest V3 browser extension starter.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/validate-manifest.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test && pnpm build",
    "precommit": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test",
    "prepare": "sh ./scripts/install-hooks.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/chrome": "0.0.312",
    "@types/node": "26.0.0",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
