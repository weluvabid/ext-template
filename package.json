{
  "name": "ext-template",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Manifest V3 browser extension starter.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/validate-manifest.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test && pnpm build",
    "precommit": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test",
    "prepare": "sh ./scripts/install-hooks.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
